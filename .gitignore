# dependencies
node_modules/

# env files (never commit real secrets)
.env
.env.local
!.env.example

# build output
web/dist/
server/dist/
web/coverage/
server/coverage/

# generation script cache (regenerable, keyed by prompt hash)
tools/.cache/

# misc
.DS_Store
*.log

# Agent 
.claude 
.codex 

# Recording corpora stay local in the application repository. The prepared
# dataset is uploaded separately to Hugging Face only after consent/QA.
data/recordings/**/*.wav
data/recordings/**/*.m4a
data/recordings/**/*.mp3
data/recordings/**/*.mp4
data/recordings/**/*.aac
data/recordings/**/*.flac
data/recordings/**/*.ogg
